{% import "macros.html.j2" as macros %}

{% macro card(href, title, summary, img, date, class="") %}
<article class="card {{ class }}">
    <header>
        <a href="{{ href }}">
            {{ macros.figure_img(img) }}
        </a>
        
        <h3>
            <a href="{{ href }}">{{ title }}</a>
        </h3>
    </header>
    <p>{{ summary }}</p>
    {% if date %}
    <footer>
        <p><time>{{ date }}</time></p>
    </footer>
    {% endif %}
</article>
{% endmacro %}

