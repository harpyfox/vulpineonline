    <style>
    @font-face {
        font-family: "Pixelated MS Sans Serif";
        src: url("/fonts/ms_sans_serif.woff2") format("woff2");
        font-weight: normal;
        font-style: normal;
    }
    @font-face {
        font-family: "Pixelated MS Sans Serif";
        src: url("/fonts/ms_sans_serif_bold.woff2") format("woff2");
        font-weight: bold;
        font-style: normal;
    }
    .win95 {
        --win95-background: #cccccc;
        --win95-border: solid 2px #000000;
        --win95-outset: inset -2px -2px 0px 0px #000000, inset 2px 2px 0px 0px #FFFFFF, inset -4px -4px 0px 0px #808080, inset 4px 4px 0px 0px #DFDFDF;
        --win95-inset: inset -2px -2px 0px 0px #FFFFFF, inset 2px 2px 0px 0px #000000, inset -4px -4px 0px 0px #DFDFDF, inset 4px 4px 0px 0px #808080;
        
        image-rendering: pixelated;
        font-family: 'Pixelated MS Sans Serif', 'MS Sans Serif', 'Arial', sans-serif;
        font-size: 11px;
        line-height: normal;
        color-scheme: light;
        color: #000000;
        cursor: default;
        background-color: var(--win95-background);
        border: none;
        box-shadow: var(--win95-outset);
        padding: 6px;
        p {
            margin: 1ch;
            color: inherit;
        }
    }
    button.win95, .win95 button {
        cursor: pointer;
        padding: 8px;
        min-width: 32px;
        min-height: 32px;
        background-color: var(--win95-background);
        border: var(--win95-border);
        box-shadow: var(--win95-outset);
        * {
            position: relative;
            top: -2px;
            left: -1px;
        }
        &:hover, &button:hover {
            background-color: var(--win95-background);
        }
        &:active {
            box-shadow: var(--win95-inset);
            * {
                top: 0px;
                left: 1px;
            }
        }
    }
    *.win95.titlebar, .win95 .titlebar {
        font-weight: normal;
        padding: 2px;
        color: #ffffff;
        background: linear-gradient(to right, #000080, #2e8ecd);
        display: flex;
        flex-direction: row;
        width: 100%;
        align-items: center;
        gap: 2px;
        + img {
            display: inline flow-root;
            vertical-align: middle;
            width: 16px;
            height: 16px;
            object-fit: fill;
            flex: 0 0 auto;
        }
        img + *:not(img) {
            flex: 1 0 auto;
            font-weight: bold;
        }
        button {
            display: inline flow-root;
            vertical-align: middle;
            margin: 0;
            padding: 0;
            min-width: 16px;
            min-height: 16px;
            flex: 0 0 auto;
            background-color: var(--win95-background);
            border: none;
        }
    }
    </style>

