        <li><img class="icon" src="../img/blender-icon.svg" alt="Blender" role="img"></li>
    </ul>
</figure>
<figure><video src="img/hsalpha-animshowcase.mp4" preload="none" poster="../img/mediaplayer48.png"></video></figure>
<section class="gallery">
    <figure><video src="img/hsalpha-sprintlean.mp4" preload="none" poster="../img/mediaplayer48.png"></video></figure>
