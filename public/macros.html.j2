{% macro card(url, title, summary, img, date=None, badge=None) %}
<article class="card">
    <a href="{{ url }}">
        <img src="{{ img }}">
        {% if badge %}
        <img class="icon32 badge" src="{{ badge }}">
        {% endif %}
        <h3>{{ title }}</h3><img class="icon" src="img/newstar.gif">
    </a>
    <p>{{ summary }}</p>
    {% if date %}
    <time>{{ date }}</time>
    {% endif %}
</article>
{% endmacro %}

{% macro figure_img(url, caption) %}
<figure>
    <img src="{{ url }}" loading="lazy"></img>
    {% if caption %}
    <figcaption>{{ caption }}</figcaption>
    {% endif %}
</figure>
{% endmacro %}

{% macro figure_video(url, caption, poster=None) %}
<figure>
    {% if poster %}
    <video src="{{ url }}" preload="none" poster="{{ poster }}"></video>
    {% else %}
    <video src="{{ url }}" preload="none" poster="../img/mediaplayer48.png"></video>
    {% endif %}
    {% if caption %}
    <figcaption>{{ caption }}</figcaption>
    {% endif %}
</figure>
{% endmacro %}