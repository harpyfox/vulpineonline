</footer>

<!-- Cloudflare Web Analytics -->
<script defer src="beacon.min.js" data-cf-beacon="{'token': '40db039c866c4d49a7ca87ce6723db6e'}"></script>
<!-- End Cloudflare Web Analytics -->
{% endmacro %}

{% macro figure_img(url, caption) %}
<figure>
    <img src="{{ url }}"></img>
    {% if caption %}
    <figcaption>{{ caption }}</figcaption>
    {% endif %}
</figure>
{% endmacro %}

{% macro figure_video(url, caption, poster, class="") %}
<figure class="{{ class }}">
    {% set poster_block %}
        {% if poster %}
        "poster=\"{{ poster }}\"""
        {% endif %}
    {% endset %}
    
    <video 
    src="{{ url }}" 
    {{ poster_block }} 
    loading="lazy" 
    autoplay 
    muted
    controls 
    loop 
    playsinline
    disablepictureinpicture></video>


    {% if caption %}
    <figcaption>{{ caption }}</figcaption>
    {% endif %}
</figure>
{% endmacro %}