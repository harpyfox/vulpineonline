{% macro svg_logo() %}
<svg class="logo" xmlns="http://www.w3.org/2000/svg"
    width="256"
    height="104">
    <use href="/logo.svg#cunt"></use>
</svg>
{% endmacro %}

{% macro head() %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">

<link rel="stylesheet" href="/layout.css" type="text/css">

<link rel="stylesheet" href="/default.css" title="Default" type="text/css">
<link rel="alternate stylesheet" href="" title="Classic" type="text/css">
{# <link rel="alternate stylesheet" href="/print.css" title="Print Friendly" type="text/css"> #}

{% if icon is defined %}
{% set favicon = icon %}
{% else %}
{% set favicon = "/favicon.png" %}
{% endif %}
<link rel="icon" href="{{ favicon }}" type="image/png" sizes="50x51">
<link rel="apple-touch-icon" href="{{ favicon }}" type="image/png" sizes="50x51">
<!-- https://evilmartians.com/chronicles/how-to-favicon-in-2021-six-files-that-fit-most-needs -->

{% if title is defined %}
<title>{{ title }} :: {{ site.title }}</title>
{% else %}
<title>{{ site.title }}</title>
{% endif %}
<meta name="description" content="{{ description }}">
<meta name="author" content="{{ site.author }}"> <!-- this element is used for firefox reader author. -->
{% if href is defined %}
{% set canonical = site.canonical + href %}
{% else %}
{% set canonical = site.canonical %}
{% endif %}
<link rel="canonical" href="{{ canonical }}">

<meta name="application-name" content="{{ site.title }}">
<meta name="theme-color" content="#ffa500">
<meta name="generator" content="Jinja2">

<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="/thumbnail.webp">
<meta property="og:url" content="https://www.vulpineonline.com/">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:type" content="article">

<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="/thumbnail.png">
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@vulpineonline">
<meta name="twitter:creator" content="@vulpineonline">
<meta name="twitter:domain" content="{{ site.domain }}">
<meta name="twitter:url" content="https://www.vulpineonline.com/">

<!-- Cloudflare Web Analytics -->
<script defer src="beacon.min.js" data-cf-beacon="{'token': '40db039c866c4d49a7ca87ce6723db6e'}"></script>
<!-- End Cloudflare Web Analytics -->
{% endmacro %}

{% macro header() %}
<header role="banner">
    <a href="/#">
        <h1>
            {{ svg_logo() }}
        </h1>
    </a>
    <p>{{ site.author }}'s portfolio</p>
</header>
{% endmacro %}

{% macro nav() %}
<nav>
    <h2>Navigation</h2>
    <ul>
        {# <li><a href="/#reel">Reel</a></li> #}
        <li><a href="/#artwork">Art</a></li>
        <li><a href="/#programming">Dev</a></li>
        <li><a href="/#info">Info</a></li>
    </ul>
</nav>
{% endmacro %}

{% macro footer() %}
